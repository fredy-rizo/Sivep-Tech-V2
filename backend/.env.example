# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=8h

# MongoDB — datos de empresa, usuarios y configuración
MONGO_URI=mongodb://127.0.0.1:27017/sivep_tech

# MySQL — operación diaria (ventas, inventario, reservas, agenda…)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sivep
MYSQL_PASSWORD=sivep
MYSQL_DATABASE=sivep_tech

# Correo del formulario "Cuéntanos tu idea" (Gmail)
# SMTP_USER es la cuenta que envía; SMTP_PASS debe ser una "contraseña de aplicación" de Google
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=siveptech@gmail.com
SMTP_PASS=
CONTACT_TO=siveptech@gmail.com
CONTACT_FROM_NAME=SIVEP Tech
